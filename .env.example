
# XAMPP MariaDB local defaults: user root, empty password, port 3306
MYSQL_URL="mysql://root@127.0.0.1:3306/rentdue"

# OPENROUTER (preferred) — free route
# Get key at https://openrouter.ai/keys → set OPENROUTER_API_KEY. Free model: openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL="openrouter/free"

# Telegram Login (BotFather → your bot → Login Widget → Allowed URLs).
# BotFather shows the numeric Client ID here. Needed for /api/auth/telegram/*.
# Allowed URLs must contain the EXACT page URL the login SDK sends, which is
# always origin + pathname. Register every live variant, e.g.
# https://rentdue.store/ AND https://www.rentdue.store/ (trailing slash,
# scheme, and www all matter — the host redirects apex -> www upstream, so
# the www entries are the ones that actually match in production).
TELEGRAM_CLIENT_ID=


# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"


# PAYMENT GATEWAY CONFIGURATION (mobile-money provider)
PAYMENT_GATEWAY_URL="https://zulupay.org"
PAYMENT_PUBLIC_KEY= 
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_URL=
PAYMENT_WITHDRAW_PASSWORD=

# ADMIN SEEDING CREDENTIALS
ADMIN_PHONE=, 
ADMIN_PASSWORD=, 
ADMIN_USERNAME=

# CLOUDINARY (required — all site image uploads go here, no local-disk fallback)
# /api/admin/upload stores to Cloudinary and returns a secure_url that gets
# saved in the DB. Uploads are refused until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER="rentdue"

# ---------------------------------------------------------------------------
# EMAIL (transactional)
# ---------------------------------------------------------------------------
# Used for password-reset codes and email verification only. Registration works
# without it; the reset link simply reports that it is unavailable.
#
# Gmail with an app password is the supported starting point:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password (myaccount.google.com -> Security -> App passwords).
#   3. Put the 16-character value in MAIL_PASSWORD. Spaces are fine.
#
# Do NOT use the account's normal password here. Gmail rewrites and rate-limits
# bulk senders, so move to SES/Postmark/Resend before volume grows; only this
# file changes when you do.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_USER="you@gmail.com"
MAIL_PASSWORD="abcd efgh ijkl mnop"
MAIL_FROM="you@gmail.com"
MAIL_FROM_NAME="RentDue"
# Optional: overrides the 10s send timeout.
MAIL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PAYMENT PROVIDER CONCURRENCY
# ---------------------------------------------------------------------------
# A provider call takes tens of seconds. PAYMENT_MAX_INFLIGHT is how many may be
# in flight per operator; PAYMENT_QUEUE_TIMEOUT_MS is how long a request waits
# for a slot before returning a non-retriable "busy, try again" (it must stay
# above one provider call, or the second concurrent user always fails).
PAYMENT_MAX_INFLIGHT=8
PAYMENT_QUEUE_TIMEOUT_MS=75000
