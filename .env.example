
# XAMPP MariaDB local defaults: user root, empty password, port 3306
MYSQL_URL="mysql://root@127.0.0.1:3306/rentdue"

# OPENROUTER (preferred) — free route
# Get key at https://openrouter.ai/keys → set OPENROUTER_API_KEY. Free model: openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL="openrouter/free"



# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"


# PAYMENT GATEWAY CONFIGURATION (mobile-money provider)
PAYMENT_GATEWAY_URL="https://zulupay.org"
PAYMENT_PUBLIC_KEY= 
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_URL=
PAYMENT_WITHDRAW_PASSWORD=

# ADMIN SEEDING CREDENTIALS
ADMIN_PHONE=, 
ADMIN_PASSWORD=, 
ADMIN_USERNAME=
