
# XAMPP MariaDB local defaults: user root, empty password, port 3306
MYSQL_URL="mysql://root@127.0.0.1:3306/rentdue"

# OPENROUTER (preferred) — free route
# Get key at https://openrouter.ai/keys → set OPENROUTER_API_KEY. Free model: openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL="openrouter/free"

# Telegram Login (BotFather → your bot → Login Widget → Allowed URLs).
# BotFather shows the numeric Client ID here. Needed for /api/auth/telegram/*.
# Allowed URLs must contain the EXACT page URL the login SDK sends, which is
# always origin + pathname. Register every live variant, e.g.
# https://rentdue.store/ AND https://www.rentdue.store/ (trailing slash,
# scheme, and www all matter — the host redirects apex -> www upstream, so
# the www entries are the ones that actually match in production).
TELEGRAM_CLIENT_ID=


# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"


# PAYMENT GATEWAY CONFIGURATION (mobile-money provider)
PAYMENT_GATEWAY_URL="https://zulupay.org"
PAYMENT_PUBLIC_KEY= 
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_URL=
PAYMENT_WITHDRAW_PASSWORD=

# ADMIN SEEDING CREDENTIALS
ADMIN_PHONE=, 
ADMIN_PASSWORD=, 
ADMIN_USERNAME=

# CLOUDINARY (required — all site image uploads go here, no local-disk fallback)
# /api/admin/upload stores to Cloudinary and returns a secure_url that gets
# saved in the DB. Uploads are refused until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER="rentdue"
